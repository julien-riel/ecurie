# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# Environnements isolés des runtimes (reconstruits par `ecurie env sync`)
runtimes/**/.venv/

# Code amont copié dans un runtime faute de paquet publié — voir le README de
# l'env concerné pour la commande qui le remet en place.
runtimes/*/vendor/

# Front
node_modules/
apps/ui/dist/
apps/ui/.vite/
apps/ui/coverage/
*.local

# macOS
.DS_Store
