{
  "id": "image-to-image",
  "title": "Transformation d'image",
  "input": {
    "type": "object",
    "required": ["image", "prompt"],
    "additionalProperties": false,
    "properties": {
      "image": {
        "type": "string",
        "contentMediaType": "image/*",
        "x-ui": "file",
        "description": "Image de départ."
      },
      "prompt": {
        "type": "string",
        "minLength": 1,
        "x-ui": "textarea",
        "description": "Transformation demandée."
      },
      "negative_prompt": {
        "type": "string",
        "x-ui": "textarea",
        "description": "Ce qu'il faut éviter. Sans effet sur les modèles à guidage distillé."
      },
      "strength": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0,
        "default": 0.6,
        "description": "Force de la transformation : 0 conserve l'image de départ, 1 la redessine entièrement."
      },
      "steps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 25,
        "description": "Pas de débruitage appliqués à la portion transformée."
      },
      "guidance_scale": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 20.0,
        "default": 3.5,
        "description": "Fidélité à la consigne de transformation."
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "description": "Graine aléatoire. À conserver pour rejouer la même transformation."
      }
    }
  },
  "output": {
    "type": "object",
    "required": ["image"],
    "properties": {
      "image": {
        "type": "string",
        "contentMediaType": "image/png",
        "description": "Chemin de l'image produite, relatif au dossier du job."
      }
    }
  }
}
